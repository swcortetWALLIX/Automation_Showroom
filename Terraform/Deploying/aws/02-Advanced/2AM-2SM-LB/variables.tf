// MISC
variable "project_name" {
  description = "Project name, used in resource names and tags. Load balancer and target group names derive from it and are limited to 32 characters."
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z0-9]([A-Za-z0-9-]{0,15}[A-Za-z0-9])?$", var.project_name))
    error_message = "project_name must be 1 to 17 characters, letters, digits and inner hyphens only (AWS load balancer naming rules)."
  }
}

variable "ami-from-aws-marketplace" {
  type        = bool
  default     = true
  description = "Should we use the marketplace image ? If false, the shared image by WALLIX will be use."
}

variable "tags" {
  default     = {}
  description = "Map of tags to apply on resources."
  type        = map(string)
}

variable "aws-region" {
  type        = string
  description = "Aws region to deploy resources"
}

variable "key_pair_name" {
  description = "Name of the EC2 key pair created by this example (the key is generated by Terraform; the name must not exist yet in the region)."
  type        = string
}

// Booleans

variable "alb_internal" {
  description = "Should the Application Load Balancer be internal? If false (default), the Access Manager web UI is reachable from allowed_ips over the Internet."
  default     = false
  type        = bool
}

variable "nlb_internal" {
  description = "Should the Network Load Balancer be internal? If false, the Bastion proxies (SSH, RDP, HTTPS) are reachable from allowed_ips over the Internet."
  default     = true
  type        = bool
}

variable "deploy-integration-debian" {
  description = "Should a debian instance for integration be deployed ?"
  default     = true
  type        = bool
}

// AWS Networking

variable "vpc_cidr" {
  description = "CIDR block of the new VPC, e.g. 10.0.0.0/16. Subnets are carved from it with 6 extra bits."
  type        = string

  validation {
    condition     = can(cidrnetmask(var.vpc_cidr))
    error_message = "vpc_cidr must be a valid IPv4 CIDR block."
  }
}

variable "allowed_ips" {
  description = "Public CIDR blocks allowed to reach the ALB, the NLB and the Debian host (SSH, RDP), e.g. [\"203.0.113.10/32\"]. The VPC CIDR is always allowed on the load balancers."
  type        = list(string)

  validation {
    condition     = length(var.allowed_ips) > 0 && alltrue([for cidr in var.allowed_ips : can(cidrnetmask(cidr))]) && !contains(var.allowed_ips, "127.0.0.1/32")
    error_message = "allowed_ips must hold valid IPv4 CIDR blocks; replace the 127.0.0.1/32 placeholder with your own public IP (x.x.x.x/32)."
  }
}

// Instance Sizing

variable "aws_instance_size_am" {
  default     = "t3.medium"
  description = "Specifies the instance sizing."
  type        = string
}

variable "aws_instance_size_sm" {
  default     = "t3.medium"
  description = "Specifies the instance sizing."
  type        = string
}

variable "aws_instance_size_debian" {
  default     = "t3.medium"
  description = "Specifies the instance sizing."
  type        = string
}
variable "am_disk_size" {
  default     = 30
  description = "AM disk sizing"
  type        = number
}

variable "am_disk_type" {
  default     = "gp3"
  description = "AM disk type"
  type        = string
}

variable "sm_disk_size" {
  default     = 31
  description = "SM disk sizing"
  type        = number
}

variable "sm_disk_type" {
  default     = "gp3"
  description = "SM disk type"
  type        = string
}

variable "bastion-version" {
  default     = ""
  description = "Bastion version to use. It can be partial or full (12, 11.0, 10.4.3, 10.0.7.28). Can be empty for the latest pushed image."
  type        = string
}

variable "access-manager-version" {
  default     = ""
  description = "Access Manager version to use. It can be partial or full (5, 4.0, 4.4.1, 4.4.1.8). Can be empty for the latest pushed image."
  type        = string
}

variable "number-of-am" {
  default     = 2
  description = "Number of AM to be deployed (0 to 3)."
  type        = number

  validation {
    condition     = var.number-of-am >= 0 && var.number-of-am <= 3
    error_message = "Value should be between 0 and 3."
  }
}

variable "number-of-sm" {
  default     = 2
  description = "Number of SM to be deployed (0 to 3)."
  type        = number

  validation {
    condition     = var.number-of-sm >= 0 && var.number-of-sm <= 3
    error_message = "Value should be between 0 and 3."
  }
}
